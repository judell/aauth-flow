<App
  layout="vertical-sticky"
  name="AAuth Walkthrough"
  global.trigger="{''}"
  global.phase="{0}"
  global.phaseLabel="{'1'}"
  global.phaseMessage="{'You buy something, or a schedule does it for you (click Buy to start)'}"
  global.buttonLabel="{''}"
  global.buttonEnabled="{false}"
  global.pulseDuration="{1800}"
  global.running="{false}"
  global.stepIndex="{0}"
  global.pulse="{{ active: false, edges: [], step: -1, currentEdge: '' }}"
  global.layout="{null}">
  <AppHeader>
    <Text fontWeight="bold">
      AAuth Walkthrough
    </Text>
    <SpaceFiller />
    <Icon
      name="save"
      tooltip="Save layout"
      aria-label="Save layout"
      width="20px"
      height="20px"
      color="$color-surface-500"
      cursor="pointer"
      onClick="saveLayout()" />
      <Inspector />
  </AppHeader>

  <Pages>
    <Page url="/">
      <ReactFlowPage />
    </Page>
  </Pages>

</App>