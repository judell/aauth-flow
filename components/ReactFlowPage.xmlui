<Component name="ReactFlowPage" var.edgeLabel="" var.edgeId="" var.urlReady="{false}">
  <ModalDialog id="edgeInfoDialog" title="{edgeLabel}">
    <VStack gap="$space-2">
      <Text>
        Relationship: {edgeLabel}
      </Text>
      <Text fontSize="$fontSize-small" color="$textColor-secondary">
        Edge ID: {edgeId}
      </Text>
    </VStack>
  </ModalDialog>

  <DataSource
    id="layoutData"
    url="layout.json"
    onLoaded="{(data) => { layout = data }}" />

  <!-- Step URL: on load, jump to ?step=N[&path=scheduled]; then keep the URL in sync.
       urlReady holds off URL writes until the load-time jump has read the query. -->
  <Timer
    enabled="{layout !== null}"
    once="true"
    initialDelay="{300}"
    onTick="{() => { if ($queryParams.step) { jumpToStep($queryParams.step, $queryParams.path, $queryParams.outcome) } urlReady = true }}" />

  <!-- A URL typed into an open tab changes only the hash (no reload): jump when the
       query names a different step from the one on screen. Our own URL writes match
       stepQueryString(), so they don't re-trigger. -->
  <ChangeListener
    listenTo="{($queryParams.step || '') + '|' + ($queryParams.path || '') + '|' + ($queryParams.outcome || '')}"
    onDidChange="{() => { if (urlReady && $queryParams.step && urlStepString($queryParams.step, $queryParams.path, $queryParams.outcome) !== stepQueryString()) { jumpToStep($queryParams.step, $queryParams.path, $queryParams.outcome) } }}" />

  <ChangeListener
    listenTo="{stepIndex}"
    onDidChange="{() => { if (urlReady) { navigate($pathname + '?' + stepQueryString()) } }}" />

  <!-- Step machine completion triggers -->

  <!-- Fixed-duration completion (delegate step) -->
  <Timer
    enabled="{running && getProcessFlowSteps()[stepIndex].completeAfterMs > 0}"
    interval="{pulseDuration}"
    onTick="{() => { onTimerComplete() }}" />

  <!-- Round-trip completion (lookup, consult steps) -->
  <Timer
    enabled="{running && getProcessFlowSteps()[stepIndex].completeAfterRoundTrip}"
    interval="{pulseDuration * 2}"
    onTick="{() => { onRoundTripTimerComplete() }}" />

  <!-- Pulse sequence engine -->
  <Timer
    enabled="{pulse.active}"
    interval="{pulseDuration}"
    onTick="{() => { if (pulse.step < pulse.edges.length) { canvas.pulseEdge(pulse.edges[pulse.step], pulseDuration); pulse = { active: true, edges: pulse.edges, step: pulse.step + 1, currentEdge: pulse.edges[pulse.step] } } else { canvas.clearPulse(); pulse = { active: false, edges: pulse.edges, step: pulse.step, currentEdge: pulse.currentEdge } } }}" />

  <!-- Pulse sequence completion -->
  <ChangeListener
    listenTo="{pulse.active}"
    onDidChange="{() => { if (!pulse.active && running) { onPulseSequenceComplete() } }}" />

  <Stack
    height="calc(100vh - 48px)"
    width="100%"
    when="{layout !== null}"
    position="relative">
    <ReactFlowCanvas
      id="canvas"
      canvasFontSize="{18}"
      fitView="{true}"
      fitViewPadding="{.15}"
      snapToGrid="{true}"
      showMinimap="{false}"
      showControls="{true}"
      showBackground="{true}"
      onEdgeInfoClick="{(e) => { edgeLabel = e.label; edgeId = e.edgeId; edgeInfoDialog.open() }}"
      nodes="{(phase, phaseLabel, phaseMessage, buttonLabel, buttonEnabled, running, stepIndex, pulse.active, pulse.currentEdge, trigger, outcome, getNodes())}"
      edges="{getEdges()}">
      <PersonNode />
      <PersonAgentNode />
      <AgreementsPanel />
      <EntityAgentNode />
      <HStack>
        <H1 maxWidth="800px">
          {phaseLabel} {phaseMessage}
        </H1>
        <ControlNode />
      </HStack>
      <!-- Last: pairs by order with the node getNodes() appends from scene 2 -->
      <EntityNode />
    </ReactFlowCanvas>
  </Stack>
</Component>