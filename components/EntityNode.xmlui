<Component name="EntityNode">
  <ModalDialog id="entityHelp" title="Your sign-in">
    <Text>
      Vouches for you: "this person approved this agent." You sign in the usual way (Microsoft here), then confirm the agent. Hellō is the first place you can try it. (Spec term: person server.) The scheduled path, approving later from a link, is inferred from the protocol; the recorded run was interactive.
    </Text>
  </ModalDialog>
  <VStack gap="$space-1" padding="$space-2">
    <HStack verticalAlignment="center" horizontalAlignment="center" gap="$space-2">
      <Icon name="building2" width="24px" height="24px" />
      <Text fontWeight="bold" fontSize="$fontSize-lg">Your sign-in</Text>
    </HStack>
    <Text fontSize="$fontSize-small" color="$textColor-secondary">vouches for you · Hellō</Text>
    <VStack gap="$space-1" when="{phase >= 11}">
      <Text fontSize="$fontSize-small" fontWeight="bold" color="$color-primary">Confirm screen</Text>
      <Text fontSize="$fontSize-small">agent judell · local@judell.github.io</Text>
      <Text fontSize="$fontSize-small">code HBHK-S3ZN · new agent</Text>
      <Text fontSize="$fontSize-small" fontWeight="bold">confirmed by Jon</Text>
    </VStack>
  </VStack>
</Component>
