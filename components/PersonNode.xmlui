<Component name="PersonNode">
  <ModalDialog id="personHelp" title="You">
    <Text>
      The person the agent acts for. You start things: by acting yourself, or by setting up a schedule that acts for you.
    </Text>
  </ModalDialog>
  <VStack
    gap="$space-1"
    padding="$space-2"
    height="100%"
    horizontalAlignment="center">
    <HStack horizontalAlignment="center" verticalAlignment="center" gap="$space-2">
      <Icon name="person" width="24px" height="24px" />
      <Text fontWeight="bold" fontSize="$fontSize-lg">You</Text>
      <Icon
        name="info"
        tooltip="About You"
        aria-label="About You"
        width="18px"
        height="18px"
        color="$color-primary"
        cursor="pointer"
        onClick="personHelp.open()" />
    </HStack>
    <VStack gap="$space-1" height="*" verticalAlignment="center" horizontalAlignment="center">
      <Text fontSize="$fontSize-small" color="$textColor-secondary">Interactive</Text>
      <Button
        label="Buy"
        enabled="{stepIndex === 0 && !running}"
        onClick="startBuy('interactive')" />
      <Text fontSize="$fontSize-small" fontWeight="bold" when="{phase >= 10 && trigger === 'interactive'}">
        approve: code HBHK-S3ZN · on screen now
      </Text>
    </VStack>
    <ContentSeparator />
    <VStack gap="$space-1" height="*" verticalAlignment="center" horizontalAlignment="center">
      <Text fontSize="$fontSize-small" color="$textColor-secondary">Scheduled</Text>
      <HStack verticalAlignment="center" gap="$space-2">
        <Icon
          name="calendar-clock"
          tooltip="Fire the schedule"
          aria-label="Fire the schedule"
          width="24px"
          height="24px"
          cursor="pointer"
          onClick="startBuy('scheduled')" />
        <Text fontSize="$fontSize-small">weekly reorder</Text>
      </HStack>
      <Text fontSize="$fontSize-small" fontWeight="bold" when="{phase >= 10 && trigger === 'scheduled'}">
        approve: code HBHK-S3ZN · on your phone, within 10 min
      </Text>
    </VStack>
  </VStack>
</Component>
